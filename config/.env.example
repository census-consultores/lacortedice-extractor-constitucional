# ── Worker API ────────────────────────────────────────────────────────────────
WORKER_API_KEY=cambia-esto-por-un-secreto-seguro

# ── Postgres (misma BD que Strapi) ───────────────────────────────────────────
DATABASE_URL=postgresql://strapi:strapi@localhost:5433/strapi

# ── Strapi ────────────────────────────────────────────────────────────────────
STRAPI_URL=http://localhost:1337
STRAPI_API_TOKEN=pega-aqui-el-token-de-strapi

# ── IA ────────────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-proj-...
DEEPINFRA_API_KEY=...
OPENROUTER_API_KEY=sk-or-v1-...

# ── Jobs ─────────────────────────────────────────────────────────────────────
MAX_CONCURRENT_JOBS=2
